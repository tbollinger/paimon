# pAImon Configuration
PORT=3000
REFRESH_INTERVAL=5
RETENTION_DAYS=90
CLAUDE_HOME=~/.claude
# Optional: enables real cost data from Anthropic API
# ANTHROPIC_API_KEY=
# Budget thresholds (USD)
# DAILY_BUDGET_USD=
# MONTHLY_BUDGET_USD=
# Background style: true = dithered dots, false = plain white
DITHERED_BACKGROUND=false
